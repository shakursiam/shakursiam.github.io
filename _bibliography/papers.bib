@article{siam2026battery,
  abbr        = {J. Energy Storage},
  bibtex_show = {true},
  title       = {Edge-Deployed Battery State-of-Health Estimation on a Custom Synchronous Buck Charging Platform: A Cross-Dataset Lightweight Machine Learning Framework},
  author      = {Siam, Md. Abdus Shakur and Talukder, Muhammad Anisuzzaman},
  journal     = {Journal of Energy Storage (Elsevier)},
  year        = {2026},
  abstract    = {Despite advances in battery prognostics, a persistent gap remains between algorithmically accurate machine learning (ML) models and their practical deployment on resource-constrained battery management systems (BMS). This work addresses these gaps via the Edge-SBC, a custom hardware platform integrating a BQ24610 charge controller with an ESP32-S3 host for simultaneous precision charging and on-device ML inference. Benchmarking a zero-data-leakage pipeline across four public datasets yields within-dataset State of Health (SoH) R2 up to 0.9992. A systematic 32-experiment cross-dataset protocol identifies protocol affinity, rather than chemistry, as the dominant transfer factor (leave-one-dataset-out R2 ceiling of 0.761). For deployment, a Float32-downcasted HistGradientBoosting model achieves 52 microseconds latency and <=21 microjoules energy within a 500 KB Flash budget. Live Physical-in-the-Loop (PhIL) validation on two differing 18650 cells (NMC and LCO) demonstrates operational feasibility, achieving optimal mean absolute SoH errors of 1.80% (NMC, 60-minute window) and 2.38% (LCO, end-of-charge).},
  note        = {Under final review (internal/editorial) — full text not yet public},
  selected    = {true}
}

@article{siam2026aiotsurvey,
  abbr        = {JNCA},
  bibtex_show = {true},
  title       = {Privacy and Secure Networking in AI-enabled Internet of Things Systems: A Review},
  author      = {Siam, Md Abdus Shakur and Dey, Shamik and Ali, Muhammad Imran and Haque, Md. Sabit Shahriar and Farrok, Omar},
  journal     = {Journal of Network and Computer Applications},
  year        = {2026},
  abstract    = {Federated intrusion detection systems routinely exceed 99% accuracy on IoT benchmarks, yet only three of 168 reviewed studies validate on live or physical-testbed traffic, and a white-box adversarial attack achieves 100% success against a high-accuracy deep learning classifier. This survey synthesises 168 studies (2019-2026) on AI-specific threat vectors, privacy-preserving mechanisms, and secure networking for IoT within a four-dimensional taxonomy: system layer, AI lifecycle stage, threat category, and AI paradigm class. We derive seven deployment-readiness requirements, mapped to NIST AI RMF 1.0, ISO/IEC 42001:2023, and IEEE Std 2413-2019, and argue that adversarial stress-testing, formal privacy quantification, and governance alignment must become mandatory evaluation standards.},
  note        = {Under final review (internal/editorial) — full text not yet public},
  selected    = {true}
}

@article{siam2026coolpaints,
  abbr        = {Energy & Buildings},
  bibtex_show = {true},
  title       = {Multi-Seasonal Assessment of Nanostructured Cool Paints for Passive Radiative Cooling in Tropical Climates Using IoT Sensor Networks},
  author      = {Siam, Md. Abdus Shakur and Hossain, Md. Fahim and Imtiaz, Ahmed and Mahmud, A. S. M. Obaidullah and Talukder, Muhammad Anisuzzaman},
  journal     = {Energy and Buildings (Elsevier)},
  year        = {2026},
  abstract    = {Rapid urbanisation and intensifying urban heat island effects are escalating building cooling loads in tropical monsoon (Koppen Am) cities. This study evaluates a dual-component nanostructured cool paint system through a seven-month continuous IoT field campaign (November 2024-May 2025) on three pilot enclosures in Dhaka, Bangladesh, using a custom ESP32/DHT22 sensor network, supplemented by controlled laboratory infrared step-heating chamber testing. The cool-paint system delivered a peak midday internal temperature reduction of 4.15 degC (10.74%) at the April pre-monsoon maximum, with the NOAA Heat Index suppressed by ~5 degC under peak pre-monsoon loading. Scaled to a four-storey residential building, the system yielded a base-case net electrical saving of 164.3 kWh and a carbon abatement of 112.0 kg CO2 over six months.},
  note        = {Manuscript complete, pending submission (internal/editorial) — full text not yet public. Industry-funded by Berger Paints Bangladesh Ltd.},
  selected    = {true}
}

